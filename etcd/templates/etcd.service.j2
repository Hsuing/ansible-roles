[Unit]
Description=etcd {{ etcd_version }} ({{ etcd_service_name }})
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory={{ etcd_datadir }}
User={{ etcd_user }}
Group={{ etcd_user }}
EnvironmentFile={{ etcd_confdir }}/etcd.conf
ExecStart={{ software_install_path }}/etcd/etcd
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
