[Unit]
Description=Redis In-Memory Data Store
Documentation=http://redis.io/documentation
After=network.target

[Service]
Type=simple
ExecStart={{ software_install_path }}/redis/bin/redis-server {{ redis_dir_path }}/redis.conf --daemonize no
KillSignal=SIGTERM
User={{ redis_user }}
Group={{ redis_user }}
LimitNOFILE=65536
LimitNPROC=65536
TimeoutStartSec=0
Restart=always
RestartSec=10s
TasksMax=infinity
OOMScoreAdjust=-999

[Install]
WantedBy=multi-user.target
